{
  "rewrites": [
    {
      "source": "/brochures/:file",
      "destination": "/public/brochures/:file"
    },
    {
      "source": "/plans",
      "destination": "/index.html"
    },
    {
      "source": "/plans/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/hnw",
      "destination": "/index.html"
    },
    {
      "source": "/health-knowledge",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/tax-planner",
      "destination": "/index.html"
    },
    {
      "source": "/calculator",
      "destination": "/index.html"
    },
    {
      "source": "/plan-advisor",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|brochures/|data/|plan-covers/|favicon|robots|sitemap).*[^.][^/]*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}